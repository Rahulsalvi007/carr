# RoadGuard AI Configuration Environment Variables

# Database Connection (Default SQLite, or PostgreSQL)
DATABASE_URL=sqlite:///./traffic_monitoring.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/traffic_db

# AI Detection Thresholds (0.0 - 1.0)
VEHICLE_THRESHOLD=0.50
HELMET_THRESHOLD=0.70
PLATE_THRESHOLD=0.65
OCR_THRESHOLD=0.75
EV_THRESHOLD=0.80

# Violation Cooldown in seconds (deduplication filter)
VIOLATION_COOLDOWN_SECONDS=60

# Model Paths (Optional custom overrides)
# HELMET_MODEL_PATH=backend/models/helmet/best.pt
# PLATE_MODEL_PATH=backend/models/plate/best.pt
# EV_MODEL_PATH=backend/models/vehicle/ev_classifier.pt
